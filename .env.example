OPENROUTER_API_KEY=
# Optional override; otherwise config/matching.json supplies the shared value.
# ACCEPTED_EXTRA_PICKUP_MINUTES=0
# Verified on 2026-11-11; confirm current availability before reproducing.
OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free

# Langfuse project keys stay private. Set the base URL for your project region.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Increase for slow proxy/network connections.
LANGFUSE_TIMEOUT=30
# Required for hosted API tracing: use the full source SHA from git rev-parse HEAD.
SOURCE_COMMIT=
# Set to 1 for a key-free demo that disables the live /match route and hosted SDK.
# RIDE_MATCHER_DEMO_ONLY=1
